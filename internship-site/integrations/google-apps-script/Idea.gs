/** Separate venture intake; same CAPTCHA, quotas, injection protection and retry path. */
function ventureIntakeEnabled_(){var p=PropertiesService.getScriptProperties();return p.getProperty('FORM_KIND')==='venture'||p.getProperty('VENTURE_INTAKE_ENABLED')==='true';}
function submitIdea(raw,token,captchaResponse){if(!ventureIntakeEnabled_())throw Error('Wrong form endpoint');return submitValidated_(validateIdea_(raw),token,captchaResponse,'venture');}
function validateIdea_(raw){if(!raw||typeof raw!=='object'||Array.isArray(raw)||raw.website)throw Error('Invalid idea');var d={};var limits={requestId:36,name:100,email:180,phone:30,organisation:160,title:120,stage:60,team:60,problem:2000,users:1000,approach:2000,evidence:1500,support:1000,link:500};Object.keys(limits).forEach(k=>{if(raw[k]!=null&&typeof raw[k]!=='string')throw Error('Invalid '+k);d[k]=String(raw[k]||'').trim();if(d[k].length>limits[k])throw Error('Invalid '+k);});['name','email','phone','title','stage','team','problem','users','approach','support'].forEach(k=>{if(!d[k])throw Error('Required '+k)});if(!/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(d.requestId)||!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(d.email))throw Error('Invalid identity');if(!/^[+0-9 ().-]+$/.test(d.phone)||d.phone.replace(/\D/g,'').length<8||d.phone.replace(/\D/g,'').length>15)throw Error('Invalid mobile');if(d.problem.length<20||d.approach.length<20||d.users.length<10||d.support.length<10)throw Error('Add a clearer brief');if(d.link&&!/^https?:\/\/[^\s]+$/i.test(d.link))throw Error('Invalid public link');if(!['Exploring a problem','Customer research','Prototype in progress','Working prototype','Early pilot'].includes(d.stage)||!['Solo founder / builder','Student team','Working professionals','Faculty-led team','Other'].includes(d.team))throw Error('Invalid stage or team');acceptPolicies_(raw,d);return d;}
function ideaRow_(d,p){return [new Date().toISOString(),d.requestId,d.name,d.email,d.phone,d.organisation,d.title,d.stage,d.team,d.problem,d.users,d.approach,d.evidence,d.support,d.link,'Non-confidential initial brief',p.getProperty('PROTOTYPE_MODE')!=='false'?'Prototype':'Live',d.termsVersion,d.privacyVersion,new Date().toISOString(),'Accepted','Consented'].map(safeCell_);}
function setupVenture_(){var p=PropertiesService.getScriptProperties();if(p.getProperty('VENTURE_SPREADSHEET_ID'))return;var book=SpreadsheetApp.create('SamkhyaAcademy — Venture Ideas'),s=book.getSheets()[0];s.setName('Source Responses');s.appendRow(['Received (UTC)','Reference','Full name','Email','Phone','Organisation','Idea title','Founder stage','Team','Problem','Users','Approach','Evidence','Support','Public link','Brief acknowledgement','Mode','Terms version','Privacy version','Accepted UTC','Terms acknowledgement','Processing consent']);p.setProperty('VENTURE_SPREADSHEET_ID',book.getId());p.setProperty('VENTURE_SOURCE_SHEET','Source Responses');p.setProperty('FORM_KIND','venture');p.setProperty('CRM_KIND','venture');p.setProperty('PROTOTYPE_MODE','true');}
