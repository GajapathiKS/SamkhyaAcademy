function crmStyleTables_(book,kind){
 ['Pipeline','Follow-ups','Activity','Settings','Read Me','Source Responses','Program Interests'].forEach(name=>{var s=book.getSheetByName(name);if(!s)return;var cols=s.getLastColumn(),rows=Math.max(2,s.getLastRow());s.setHiddenGridlines(true);s.setTabColor(name==='Pipeline'?'#1768a6':name==='Follow-ups'?'#ac3d49':name==='Settings'?'#a76413':'#087d85');s.getRange(1,1,rows,cols).setFontFamily('Arial').setFontSize(10).setVerticalAlignment('middle');s.getRange(1,1,1,cols).setBackground('#112b49').setFontColor('#ffffff').setFontWeight('bold').setWrap(true);s.setRowHeight(1,42);s.setRowHeights(2,rows-1,32);s.setFrozenRows(1);if(name==='Pipeline'){s.setFrozenColumns(3);s.setColumnWidths(1,cols,135);s.setColumnWidth(1,185);s.setColumnWidth(3,165);s.setColumnWidth(6,230);s.setColumnWidth(12,250);s.setColumnWidth(14,290);s.getRange(2,8,rows-1,12).setBackground('#e6f3ff');s.getRange(2,1,rows-1,7).setBackground('#f0f3f7');var palettes={'New':['#dceafb','#174a7b'],'Contacted':['#ddf4f0','#086c68'],'Qualified':['#b8e6df','#065b51'],'Joined':['#087d85','#ffffff'],'Under review':['#dceafb','#174a7b'],'Clarification requested':['#fff0c7','#7c4b08'],'Discussion scheduled':['#d5ebfa','#155781'],'Accepted':['#b8e6df','#065b51'],'Active engagement':['#087d85','#ffffff'],'Completed':['#31516d','#ffffff'],'On hold':['#fff0c7','#7c4b08'],'Declined':['#f8dce0','#882c38'],'Not interested':['#f8dce0','#882c38'],'Closed':['#d9e0e8','#40556d']};var rules=s.getConditionalFormatRules().filter(rule=>{var c=rule.getBooleanCondition();return !(c&&c.getCriteriaType()===SpreadsheetApp.BooleanCriteria.TEXT_EQUAL_TO&&palettes[String(c.getCriteriaValues()[0])]&&rule.getRanges().every(r=>r.getColumn()===8&&r.getNumColumns()===1));});Object.entries(palettes).forEach(([status,c])=>rules.unshift(SpreadsheetApp.newConditionalFormatRule().whenTextEqualTo(status).setBackground(c[0]).setFontColor(c[1]).setRanges([s.getRange(2,8,Math.max(999,rows-1),1)]).build()));s.setConditionalFormatRules(rules);s.getRange('H