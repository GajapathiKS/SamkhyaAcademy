/* Pure reporting rules shared by Apps Script and local verification. No network or storage. */
var CRMCore=(function(){
 const statuses={program:['New','Contacted','Qualified','Joined','On hold','Not interested','Closed'],venture:['New','Under review','Clarification requested','Discussion scheduled','Accepted','Active engagement','Completed','On hold','Declined']};
 const stages=['Idea & opportunity','Customer validation','Business model','MVP planning','Pilot & launch','Measure & learn','Scale readiness'];
 const closed=['Joined','Not interested','Closed','Completed','Declined'];
 const day=86400000;
 function iso(value){if(!value)return '';const d=new Date(value);return Number.isNaN(+d)?'':d.toISOString();}
