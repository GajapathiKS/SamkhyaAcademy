---
import { site } from '../../site.config.mjs';
import { tracks } from '../data/programs';

const number = site.whatsapp.replace(/\D/g, '');
const configured = /^[1-9]\d{7,14}$/.test(number);
const path = Astro.url.pathname;
const program = Object.values(tracks).find(p => path.startsWith(`/programs/${p.slug}/`));
const subject = program?.title ?? (path.startsWith('/venture-studio/') ? 'Venture Launchpad startup advisory' : 'your academy programs');
const message = `Hello SamkhyaAcademy! I would like to enquire about ${subject}. Could you share more details?`;
const href = `https://wa.me/${number}?text=${encodeURIComponent(message)}`;
---
{configured && <a class="whatsapp-float" href={href} target="_blank" rel="noopener noreferrer" aria-label="Enquire on WhatsApp (opens in a new tab)" title="Enquire on WhatsApp">
  <span class="whatsapp-label">Chat on WhatsApp</span>
  <svg viewBox="0 0 24 24" width="29" height="29" fill="currentColor" aria-hidden="true"><path d="M20.52 3.48A11.9 11.9 0 0 0 12.05 0C5.47 0 .12 5.35.12 11.93c0 2.1.55 4.15 1.6 5.96L0 24l6.28-1.65a11.9 11.9 0 0 0 5.77 1.47h.01C18.63 23.82 24 18.47 24 11.89c0-3.18-1.24-6.17-3.48-8.41ZM12.06 21.8a9.86 9.86 0 0 1-5.03-1.38l-.36-.21-3.73.98 1-3.64-.24-.38a9.87 9.87 0 0 1-1.52-5.24c0-5.46 4.44-9.9 9.9-9.9a9.83 9.83 0 0 1 7 2.9 9.83 9.83 0 0 1 2.9 7c0 5.46-4.45 9.9-9.92 9.9Zm5.43-7.42c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.4-1.48-.9-.8-1.5-1.78-1.67-2.08-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.91-2.2-.24-.59-.49-.51-.67-.52h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.87 1.22 3.07c.15.2 2.1 3.21 5.09 4.5.71.31 1.27.49 1.7.62.72.23 1.37.2 1.89.12.58-.09 1.76-.72 2.01-1.42.25-.69.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35Z"/></svg>
</a>}
<style>
  .whatsapp-float{position:fixed;right:max(24px,env(safe-area-inset-right));bottom:max(24px,env(safe-area-inset-bottom));z-index:30;display:flex;align-items:center;justify-content:center;width:58px;height:58px;border:2px solid white;border-radius:50%;background:#137c43;color:white;box-shadow:0 5px 20px #102b3526;text-decoration:none;transition:background .15s,box-shadow .15s}
  .whatsapp-float:hover{background:#0e6636;box-shadow:0 6px 24px #102b3540}
  .whatsapp-float:focus-visible{outline:3px solid #173b69;outline-offset:4px}
  .whatsapp-label{position:absolute;right:70px;white-space:nowrap;padding:9px 13px;border:1px solid #dfe5ed;border-radius:10px;background:white;color:#142547;font-size:13px;box-shadow:0 3px 14px #102b3512;opacity:0;pointer-events:none}
  .whatsapp-float:hover .whatsapp-label,.whatsapp-float:focus-visible .whatsapp-label{opacity:1}
  @media(max-width:600px){.whatsapp-float{right:max(16px,env(safe-area-inset-right));bottom:max(16px,env(safe-area-inset-bottom));width:52px;height:52px}.whatsapp-label{display:none}}
</style>
