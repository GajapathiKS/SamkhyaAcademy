---
import sample from '../assets/certificate-sample.svg?raw';
import Icon from './Icon.astro';
import { completionRecognition as recognition } from '../data/completionRecognition';
interface Props { programTitle:string; example?:boolean }
const {programTitle,example=false}=Astro.props;
const escape=(value:string)=>value.replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;');
const artwork=sample.replaceAll('AI Engineering Training Internship',escape(programTitle)).replace('Python · Full-stack foundations · Generative AI · Applied projects','Practical learning · Applied work · Demonstrated understanding').replace('font-size="35"','font-size="30"');
const image='data:image/svg+xml,'+encodeURIComponent(artwork);
---
{recognition.published && <section id="completion-recognition" class="container section completion-recognition" aria-labelledby="recognition-title"><div><p class="eyebrow"><Icon name="shield"/> COMPLETION RECOGNITION</p><h2 id="recognition-title">{recognition.heading}</h2><p>{recognition.description}</p>{example && <p class="certificate-example">The AI Engineering Training Internship certificate is shown as an example.</p>}<button type="button" class="button outline" id="certificate-open"><Icon name="search"/>{example?'View example certificate':'View certificate'}</button></div><figure><img src={image} width="1600" height="1132" loading="lazy" alt={`Illustrative ${programTitle} completion certificate with fictional learner Alex Example and the SamkhyaAcademy logo`}/></figure><dialog id="certificate-dialog" aria-labelledby="certificate-dialog-title"><div class="certificate-toolbar"><h2 id="certificate-dialog-title">{programTitle}</h2><button type="button" class="button outline small" id="certificate-close"><Icon name="plus"/>Close</button></div><img src={image} width="1600" height="1132" alt={`Enlarged illustrative ${programTitle} certificate. Illustrative certificate only.`}/></dialog></section>}
<style>.completion-recognition{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:44px;align-items:center}.completion-recognition .eyebrow{display:flex;gap:9px;align-items:center}.completion-recognition h2{margin:18px 0}.completion-recognition p{margin-bottom:22px}.completion-recognition .certificate-example{font-size:.82rem;color:#52617b}.completion-recognition figure{margin:0;transform:rotate(-1deg)}.completion-recognition img{display:block;width:100%;height:auto;border:1px solid #e1e5ed;border-radius:5px;box-shadow:0 16px 40px #16345b18}#certificate-dialog{width:min(1200px,calc(100% - 24px));max-height:94dvh;overflow:auto;border:0;border-radius:14px;padding:20px;background:#f4f6fa;color:#152346}#certificate-dialog::backdrop{background:#111b3dc9}#certificate-dialog img{box-shadow:none}.certificate-toolbar{display:flex;justify-content:space-between;align-items:center;gap:18px;margin-bottom:16px}.certificate-toolbar h2{font-size:1rem;margin:0}#certificate-close :global(.icon){transform:rotate(45deg)}@media(max-width:768px){.completion-recognition{grid-template-columns:1fr;gap:24px}.completion-recognition figure{transform:none}#certificate-dialog{padding:12px}.certificate-toolbar{align-items:flex-start}.certificate-toolbar h2{font-size:.85rem}}</style>
<script>
const trigger=document.querySelector<HTMLButtonElement>('#certificate-open'),dialog=document.querySelector<HTMLDialogElement>('#certificate-dialog');
if(trigger&&dialog){trigger.addEventListener('click',()=>dialog.showModal());document.querySelector('#certificate-close')?.addEventListener('click',()=>dialog.close());dialog.addEventListener('close',()=>trigger.focus());}
</script>
