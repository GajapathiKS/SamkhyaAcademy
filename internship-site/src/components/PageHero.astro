---
import Art from './Art.astro';
import Icon from './Icon.astro';
import {tracks} from '../data/programs';
interface Props {eyebrow:string;title:string;description:string;image?:string;imageAlt?:string;caption?:string;}
const {eyebrow,title,description,image,imageAlt=''}=Astro.props;
const path=Astro.url.pathname;
const track=Object.values(tracks).find(t=>path.startsWith(`/programs/${t.slug}/`));
const venture=path.startsWith('/venture-studio/');
const parent=track?{name:track.shortTitle,href:`/programs/${track.slug}/`}:venture?{name:'Venture Launchpad',href:'/venture-studio/'}:undefined;
---
<section class:list={['page-hero','unified-hero',{'has-art':image,'quiet-art':!venture}]}><div class="container"><div class="hero-blend"><div class="hero-content"><p class="eyebrow">{eyebrow}</p><h1>{title}</h1><p class="lede">{description}</p><slot/></div>{image&&<div class="hero-scene"><Art name={image} alt={imageAlt} priority/></div>}</div><nav class="breadcrumb" aria-label="Breadcrumb"><a href={track?'/programs/':'/'}>{track?'Programs':'Home'}</a><Icon name="chevron"/>{parent&&<><a href={parent.href}>{parent.name}</a><Icon name="chevron"/></>}<span>{eyebrow}</span></nav></div></section>
<style>.unified-hero{padding-block:16px 18px;background:#fcfcfc}.unified-hero .breadcrumb{margin:12px 0 0;flex-wrap:wrap;font-size:.65rem}.hero-blend{position:relative;isolation:isolate}.has-art .hero-blend{overflow:hidden;min-height:410px;display:flex;align-items:center;padding:42px 34px;border:1px solid #e3e8ef;border-radius:12px 36px 12px 12px;background:#fcfcfc;box-shadow:0 12px 30px #20385208}.hero-content{position:relative;z-index:1}.has-art .hero-content{width:55%;padding-right:28px}.hero-content h1{font-size:clamp(2rem,3.4vw,3.2rem);line-height:1.16}.hero-content .lede{font-size:.94rem;line-height:1.8;max-width:680px;margin-top:22px}.hero-scene{position:absolute;inset:0 0 0 43%;z-index:0;mask-image:linear-gradient(90deg,transparent,#000 44%)}.hero-scene :global(.art),.hero-scene :global(picture){height:100%;display:block}.hero-scene :global(img){width:100%;height:100%;object-fit:cover;object-position:center;aspect-ratio:auto;border-radius:0}.hero-scene :global(.illustration-note){display:none}@media(max-width:850px){.has-art .hero-blend{padding:28px 25px 0;display:block;min-height:0;border-radius:12px 24px 12px 12px}.has-art .hero-content{width:100%;padding:0;background:none}.hero-scene{position:relative;inset:auto;mask-image:linear-gradient(180deg,transparent,#000 32%);height:285px;margin:22px -25px 0}.hero-content h1{font-size:2.35rem}}@media(max-width:480px){.hero-scene{height:220px}.hero-content h1{font-size:1.95rem}.hero-content .lede{font-size:.85rem}.has-art .hero-blend{padding:24px 20px 0}.hero-scene{margin-inline:-20px}}.quiet-art.has-art .hero-content{width:53%;padding-right:24px}.quiet-art .hero-scene{left:51%;mask-image:linear-gradient(90deg,transparent,#000 32%)}.quiet-art .hero-scene :global(img){object-position:65% center}.quiet-art.has-art .hero-blend{min-height:380px;padding-block:32px}.quiet-art .hero-content h1{font-size:clamp(2rem,3.1vw,3rem)}@media(max-width:850px){.quiet-art.has-art .hero-content{width:100%;padding-right:0}.quiet-art .hero-scene{left:auto;mask-image:linear-gradient(180deg,transparent,#000 24%)}.quiet-art.has-art .hero-blend{padding-block:25px 0;min-height:0}.unified-hero{padding-top:12px}.quiet-art .hero-content h1{font-size:2.1rem}}@media(max-width:480px){.quiet-art .hero-content h1{font-size:1.85rem}}
</style>
