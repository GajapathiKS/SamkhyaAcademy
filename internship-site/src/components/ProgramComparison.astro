---
import Icon from './Icon.astro';
import {directions} from '../data/academy';
import {programOrder} from '../data/catalog';
const entries=[...directions].sort((a,b)=>programOrder.indexOf(a.href)-programOrder.indexOf(b.href));
---
<section class="container section" id="compare"><div class="compare-heading"><span class="compare-symbol"><Icon name="layers"/></span><h2>Compare your learning paths.</h2></div><p>Choose by audience and the work you want to demonstrate.</p><div class="comparison" tabindex="0" role="region" aria-label="Program comparison, scroll horizontally on small screens"><table><caption>Audiences and planned outputs from the program guides</caption><thead><tr><th scope="col"><span class="column-label"><Icon name="book"/>Program</span></th><th scope="col"><span class="column-label"><Icon name="users"/>Best for</span></th><th scope="col"><span class="column-label"><Icon name="target"/>Planned output</span></th></tr></thead><tbody>{entries.map(p=><tr><th scope="row"><a class="program-label" href={p.href}><span class="program-symbol"><Icon name={p.href.includes("space-technology")?"satellite":p.href.includes("machine-learning")?"brain":p.icon}/></span><span>{p.title}</span><Icon name="arrowUpRight"/></a></th><td>{p.audience}</td><td>{p.output}</td></tr>)}</tbody></table></div></section>
<style>.comparison{overflow-x:auto;margin-top:24px;border-radius:14px}.compare-heading{display:flex;align-items:center;gap:15px}.compare-heading h2{margin:0}.compare-symbol,.program-symbol{display:inline-flex;align-items:center;justify-content:center;background:#e4eefb;color:#285587;border-radius:12px;padding:12px;flex-shrink:0}.program-symbol{padding:8px;border-radius:9px}.column-label,.program-label{display:flex;align-items:center;gap:10px}.program-label{color:#173b64}.program-label>span:nth-child(2){flex:1}.program-label>:global(.icon){width:15px;flex-shrink:0}.column-label :global(.icon){width:18px}.compare-heading :global(.icon){width:25px;height:25px}.comparison:focus-visible{outline:3px solid #6342ff;outline-offset:4px}table{width:100%;border-collapse:collapse;text-align:left;min-width:590px}caption{text-align:left;padding-bottom:16px;font-size:.85rem}th,td{padding:16px;border-bottom:1px solid #cbd3df;vertical-align:top;font-size:.85rem}thead{background:#183b65;color:white}tbody tr:nth-child(even){background:#f1f6fc}tbody tr:nth-child(odd){background:#fff}tbody tr:hover{background:#e9f2fc}th{font-weight:600}tbody th{width:35%}</style>
