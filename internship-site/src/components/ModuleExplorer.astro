---
import Icon from './Icon.astro';
interface Module {title:string;icon:string;summary:string;topics:string[];tools:string[];practice:string;deliverables:string[];criteria:string[]}
interface Props {modules:Module[];label:string}
const {modules,label}=Astro.props;
---
<div class="module-explorer"><nav class="explore-nav" aria-label={`${label} curriculum modules`}><p class="eyebrow">EXPLORE THE MODULES</p>{modules.map((m,i)=><a href={'#module-'+(i+1)}><Icon name={m.icon}/><span>{m.title}</span></a>)}</nav><div>{modules.map((m,i)=><details id={'module-'+(i+1)} class="fde-module" open={i===0}><summary><span class="module-index"><Icon name={m.icon}/></span><span><small>MODULE {String(i+1).padStart(2,'0')}</small><h2>{m.title}</h2><span class="module-summary">{m.summary}</span></span><Icon name="plus"/></summary><div class="module-details"><div class="two-grid"><div><h3>Topics you’ll explore</h3><ul class="check-list">{m.topics.map(t=><li>{t}</li>)}</ul></div><div><h3>Tools and their purpose</h3><ul class="check-list">{m.tools.map(t=><li>{t}</li>)}</ul></div></div><div class="lab-brief"><p class="eyebrow">PRACTICAL WORK</p><p>{m.practice}</p></div><div class="two-grid"><div><h3>Deliverables</h3><ul class="check-list">{m.deliverables.map(t=><li>{t}</li>)}</ul></div><div><h3>Review criteria</h3><ul class="check-list">{m.criteria.map(t=><li>{t}</li>)}</ul></div></div></div></details>)}</div></div>
<script>
function revealModule(){const target=document.getElementById(location.hash.slice(1));if(target instanceof HTMLDetailsElement){target.open=true;requestAnimationFrame(()=>target.scrollIntoView({block:'start',behavior:'instant'}));}document.querySelectorAll('.explore-nav a').forEach(a=>{if(a.getAttribute('href')===location.hash)a.setAttribute('aria-current','location');else a.removeAttribute('aria-current');});}revealModule();window.addEventListener('hashchange',revealModule);
</script>
<style>.module-explorer{display:grid;grid-template-columns:260px minmax(0,1fr);gap:34px;margin-top:32px}.explore-nav{position:sticky;top:95px;align-self:start;max-height:calc(100vh - 115px);overflow:auto;padding:4px}.explore-nav a{display:flex;gap:13px;align-items:flex-start;font-size:.77rem;color:#17254e;padding:15px 4px;border-bottom:1px solid #e3e7ef}.explore-nav a :global(.icon){color:#6247ef;flex:none}.explore-nav a[aria-current]{background:#f3f4fb;box-shadow:inset 3px 0 #6550df;padding-left:10px}.explore-nav a:focus-visible{outline:3px solid #6550df;outline-offset:-3px}details{scroll-margin-top:95px}summary small{font-size:.65rem;color:#6550df;display:block;margin-bottom:9px}@media(max-width:850px){.module-explorer{grid-template-columns:1fr}.explore-nav{position:static;max-height:none;overflow:visible;display:grid;grid-template-columns:1fr 1fr;gap:0 14px}.explore-nav .eyebrow{grid-column:1/-1}}@media(max-width:560px){.explore-nav a{font-size:.71rem;gap:8px}}
</style>
