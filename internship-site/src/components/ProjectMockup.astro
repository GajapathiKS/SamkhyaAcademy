---
import Icon from './Icon.astro';
interface Props { id: string; compact?: boolean; }
const { id, compact = false } = Astro.props;
---
<div class:list={['product-mockup', `mockup-${id}`, { compact }]} aria-label="Illustrative project interface concept">
 <div class="mockup-bar"><span class="mockup-dots"><i></i><i></i><i></i></span><span>BUILD / {id.toUpperCase()}</span><Icon name="code" /></div>
 {id === 'full-stack' && <div class="mockup-content"><div class="mockup-title"><Icon name="layers" /><div><strong>My learning space</strong><small>A little progress, every day.</small></div></div><div class="mockup-stats"><span><b>03</b> Subjects</span><span><b>02</b> In progress</span><span><b>01</b> Complete</span></div><div class="mockup-task"><span class="status-circle done"><Icon name="check" /></span><div><strong>Understand Python functions</strong><small>Programming foundations</small></div><span class="mock-tag">Done</span></div><div class="mockup-task"><span class="status-circle"></span><div><strong>Connect my first API</strong><small>Full-stack development</small></div><span class="mock-tag violet">In progress</span></div><div class="mockup-task"><span class="status-circle"></span><div><strong>Explain my database design</strong><small>Project walkthrough</small></div></div><div class="mockup-bottom"><Icon name="database" /> Your work, saved for next time.</div></div>}
 {id === 'rag' && <div class="mockup-content"><div class="mockup-title"><Icon name="search" /><div><strong>Ask the handbook</strong><small>Find an answer. Check the evidence.</small></div></div><div class="mock-question">Where can I find the project submission checklist?</div><div class="mock-answer"><Icon name="sparkles" /><div><strong>Start with the project guide.</strong><p>The supplied sample guide lists the documents to prepare. Review the source before submitting.</p><span class="source-chip"><Icon name="file" /> Sample guide · Project checklist</span></div></div><div class="mockup-bottom"><Icon name="shield" /> Answers stay connected to your sources.</div></div>}
 {id === 'agents' && <div class="mockup-content"><div class="mockup-title"><Icon name="network" /><div><strong>Research workspace</strong><small>A visible path from source to draft.</small></div></div><div class="agent-mock-row"><span class="agent-avatar"><Icon name="search" /></span><div><strong>Researcher</strong><small>Gather supporting passages</small></div><Icon name="check" /></div><div class="agent-mock-row"><span class="agent-avatar"><Icon name="file" /></span><div><strong>Writer</strong><small>Turn evidence into a draft</small></div><Icon name="check" /></div><div class="agent-mock-row"><span class="agent-avatar"><Icon name="shield" /></span><div><strong>Reviewer</strong><small>Check the result against its sources</small></div><span class="mock-tag violet">Review</span></div><div class="review-strip"><Icon name="users" /> Human approval before saving</div></div>}
 {id === 'capstone' && <div class="mockup-content"><div class="mockup-title"><Icon name="brain" /><div><strong>Campus copilot</strong><small>From a useful answer to a useful next step.</small></div></div><div class="mock-question">Help me plan my next learning session.</div><div class="plan-preview"><p><Icon name="book" /> Your draft study plan</p><div><span>01</span> Review the source material</div><div><span>02</span> Practise the key concept</div><div><span>03</span> Explain what you learned</div></div><div class="review-strip"><Icon name="shield" /> Review and adjust before saving</div></div>}
 <div class="concept-label">ILLUSTRATIVE LEARNING PROJECT · NOT A LIVE APPLICATION</div>
</div>
