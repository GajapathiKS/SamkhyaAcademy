---
import Icon from './Icon.astro';
import {directions} from '../data/academy';
const paths=[{name:'Learn',audience:'Students and engineers',links:[['AI Engineering Internship','/programs/ai-engineering-internship/'],['Machine Learning','/programs/machine-learning/'],['Full-Stack Development','/programs/full-stack-development/'],['Forward Deployment Engineering','/programs/forward-deployment-engineer/']]},{name:'Lead',audience:'Executives and decision-makers',links:[['AI Strategy & Forward Deployment for Leaders','/programs/fde-for-leaders/']]},{name:'Build',audience:'College teams and founders',links:[['Space Systems','/programs/space-technology/'],['Venture Launchpad / Startup Advisory','/venture-studio/']]}];
---
<nav class="container audience-paths" aria-label="Choose Learn, Lead or Build">{paths.map(p=><section><h2><span class="path-symbol"><Icon name={p.name==='Learn'?'book':p.name==='Lead'?'compass':'rocket'}/></span>{p.name}</h2><p>{p.audience}</p><ul>{p.links.map(([label,href])=><li><a href={href}><Icon name={href.includes("space-technology")?"satellite":href.includes("machine-learning")?"brain":directions.find(d=>d.href===href)?.icon||"code"}/><span>{label}</span><Icon name="arrowUpRight"/></a></li>)}</ul></section>)}</nav>
<style>.audience-paths{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;padding-block:24px}.audience-paths section{border:1px solid #dce5f0;border-top:3px solid #4475a9;border-radius:12px;padding:20px;background:linear-gradient(145deg,#fff,#f3f7fc)}.audience-paths h2{font-size:1.4rem;display:flex;gap:12px;align-items:center}.path-symbol{display:flex;padding:10px;border-radius:10px;background:#e5eef9;color:#285587}.audience-paths a{gap:10px;width:100%;color:#23496f}.audience-paths a span:not(.icon){flex:1}.audience-paths a :global(.icon){flex-shrink:0;width:17px;height:17px;color:#3e648d}.audience-paths p{font-size:.85rem;margin:12px 0}.audience-paths ul{list-style:none;padding:0}.audience-paths a{display:inline-flex;align-items:center;min-height:44px;font-size:.85rem;padding-block:8px}@media(max-width:650px){.audience-paths{grid-template-columns:1fr}}</style>
