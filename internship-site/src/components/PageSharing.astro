---
import Icon from './Icon.astro';
import {site} from '../../site.config.mjs';
interface Props {title:string;path:string}
const {title,path}=Astro.props;
const url=new URL(path,site.domain).href;
---
<div class="page-sharing" data-share-url={url} data-share-title={title}><span class="share-heading"><Icon name="share" />Share this page</span><div class="share-actions" role="group" aria-label="Page sharing options"><a href={`https://wa.me/?text=${encodeURIComponent(title+' — '+url)}`} target="_blank" rel="noopener noreferrer" aria-label="Share this page on WhatsApp"><Icon name="chat" /><span>WhatsApp</span><Icon name="arrowUpRight" /></a><button type="button" class="native-share"><Icon name="share" /><span>More options</span></button><button type="button" class="copy-page-link"><Icon name="copy" /><span>Copy link</span></button></div><span class="share-result" role="status"></span></div>
<script>document.querySelectorAll<HTMLElement>('.page-sharing').forEach(el=>{const url=el.dataset.shareUrl!,title=el.dataset.shareTitle!;if(!navigator.share)el.querySelector<HTMLButtonElement>('.native-share')!.hidden=true;el.querySelector('.native-share')?.addEventListener('click',async()=>{if(navigator.share){try{await navigator.share({title,url})}catch(e){if((e as Error).name!=='AbortError')el.querySelector('.share-result')!.textContent='Use Copy link or WhatsApp to share.'}}else{el.querySelector('.share-result')!.textContent='Use Copy link or WhatsApp to share.'}});el.querySelector('.copy-page-link')?.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(url);el.querySelector('.share-result')!.textContent='Link copied.'}catch{el.querySelector('.share-result')!.textContent=url}});});</script>
<style>
.page-sharing{display:flex;flex-wrap:wrap;align-items:center;gap:14px 24px;padding:22px 0;font-size:.78rem;color:#4b607e}.share-heading{display:inline-flex;gap:9px;align-items:center;font-weight:500;color:#17365c}.share-heading :global(.icon){color:#6550df;width:19px;height:19px}.share-actions{display:flex;flex-wrap:wrap;gap:10px}.page-sharing button,.page-sharing a{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:44px;background:#fff;border:1px solid #dce3ed;border-radius:10px;padding:10px 14px;color:#17365c;font:inherit;cursor:pointer;text-decoration:none;box-shadow:0 2px 4px #17365c04}.page-sharing a :global(.icon:last-child){width:14px;height:14px;color:#65758b}.page-sharing :global(.icon){width:18px;height:18px}.page-sharing a:hover,.page-sharing button:hover{border-color:#a7b5d3;background:#f4f7fb}.page-sharing button[hidden]{display:none}.page-sharing :focus-visible{outline:3px solid #6550df;outline-offset:3px}.share-result{flex-basis:100%;overflow-wrap:anywhere;color:#365778}.share-result:empty{display:none}@media(max-width:480px){.page-sharing{gap:12px}.share-heading{flex-basis:100%}.share-actions{gap:8px}.page-sharing button,.page-sharing a{padding:10px 12px;font-size:.75rem}}
</style>
