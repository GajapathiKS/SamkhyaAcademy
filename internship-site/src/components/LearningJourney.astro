---
import Icon from './Icon.astro';
const steps=[['compass','Choose your track','Find the program that fits your experience and the work you want to do.'],['message','Discuss your goals','Clarify your starting point, learning path and practical scope before joining.'],['code','Learn and build','Turn concepts into focused exercises, projects or decision-making examples.'],['users','Receive feedback','Use review conversations to improve your work and explain your choices.'],['folder','Demonstrate your work','Bring your evidence together in a demonstration, portfolio or presentation.']];
---
<section class="container learning-journey" aria-labelledby="learning-journey-title">
  <div class="journey-heading"><p class="eyebrow">HOW LEARNING WORKS</p><h2 id="learning-journey-title">A clear path from interest to evidence.</h2><p>A shared learning approach, shaped around your chosen program.</p></div>
  <ol>{steps.map(([icon,title,copy],i)=><li><div class="step-top"><span class="step-icon"><Icon name={icon}/></span><span class="step-number">0{i+1}</span></div><h3>{title}</h3><p>{copy}</p></li>)}</ol>
</section>
<style>
.learning-journey{padding-top:40px;padding-bottom:40px}.journey-heading{max-width:720px}.journey-heading h2{font-size:clamp(1.4rem,2.5vw,2rem);margin:8px 0 12px}.journey-heading>p:last-child{margin-bottom:24px}.learning-journey ol{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:14px}.learning-journey li{padding:20px 18px;border:1px solid #dce4ef;border-radius:14px;background:linear-gradient(145deg,#fff,#f3f7fc);position:relative}.step-top{display:flex;justify-content:space-between;align-items:center;gap:10px}.step-icon{display:flex;padding:10px;background:#e8effa;color:#224d87;border-radius:12px}.step-number{font-size:.75rem;font-weight:600;color:#52647d}.learning-journey h3{font-size:.95rem;line-height:1.5;margin:18px 0 9px}.learning-journey li p{font-size:.8rem;line-height:1.7;margin:0;color:#425570}@media(max-width:1000px){.learning-journey ol{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:600px){.learning-journey{padding-top:28px;padding-bottom:28px}.learning-journey ol{grid-template-columns:1fr;gap:10px}.learning-journey li{padding:16px}.step-top{float:left;margin-right:14px}.step-number{display:none}.learning-journey h3{margin:0 0 6px}.learning-journey li p{clear:both;padding-top:10px}}
</style>
