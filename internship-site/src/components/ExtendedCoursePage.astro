---
import SiteLink from './SiteLink.astro';
import Layout from '../layouts/ProgramLayout.astro';
import PageHero from './PageHero.astro';
import Icon from './Icon.astro';
import ModuleExplorer from './ModuleExplorer.astro';
import ProgramEnd from './ProgramEnd.astro';
import type {ExtendedProgram} from '../data/extendedPrograms';
interface Props {course:ExtendedProgram;section:string}
const {course:p,section}=Astro.props;const base=`/programs/${p.slug}/`;
const sectionTitle=section==='overview'?p.title:section==='career-preparation'?`${p.shortTitle} ${p.key==='leadership'?'leadership':'career'} preparation`:`${p.shortTitle} ${section}`;
const headings={overview:p.headline,curriculum:p.curriculumTitle,projects:p.key==='leadership'?'Make the case. Define the decision.':'Build something you can demonstrate.', 'career-preparation':p.key==='leadership'?'Lead the conversation with evidence.':'Show the work behind your skills.'};
const descriptions={overview:p.intro,curriculum:p.curriculumIntro,projects:`Three planned ${p.key==='leadership'?'leadership exercises':'learning projects'} connect ${p.shortTitle} concepts to tangible evidence and an honest account of limitations.`, 'career-preparation':p.key==='leadership'?'Practise proposal reviews, governance decisions and executive communication.':`Prepare a clear ${p.shortTitle} portfolio, explain your decisions and practise technical conversations.`};
---
<Layout track={p.key} section={section} title={sectionTitle} description={descriptions[section as keyof typeof descriptions]}>
<PageHero slot="hero" eyebrow={section==='overview'?p.audience:sectionTitle} title={headings[section as keyof typeof headings]} description={descriptions[section as keyof typeof descriptions]} image={p.image} imageAlt={`AI-generated illustrative ${p.shortTitle} learning scene; not actual academy participants`} caption="Illustrative imagery. Planned learning opportunities.">{section==='overview'&&<div class="actions"><SiteLink class="button" href={base+'curriculum/'}>Explore the curriculum <Icon name="book"/></SiteLink><SiteLink class="text-link" href={'/enquire/?program='+p.key}>Enquire about this program <Icon name="arrowUpRight"/></SiteLink></div>}</PageHero>
{section==='overview'&&<>
<section class="container section two-grid"><div><p class="eyebrow">YOUR STARTING POINT</p><h2>A clear path from your current experience.</h2><p>{p.bridge}</p><div class="tags">{p.tags.map(t=><span>{t}</span>)}</div></div><article class="readiness-card"><h3>Scope and teaching approach</h3><p>{p.scope}</p><p>Dates, duration, fees, weekly commitment and delivery arrangements are confirmed through enquiry. No employment, certification or business outcome is guaranteed.</p></article></section>
<section class="container section section-tight"><div class="entry-paths">{p.paths.map(([title,copy])=><article class="feature"><span class="feature-icon"><Icon name="compass"/></span><h3>{title}</h3><p>{copy}</p></article>)}</div></section>
<section class="tinted section"><div class="container"><p class="eyebrow">THE LEARNING PROGRESSION</p><h2>From understanding to practical evidence.</h2><ol class="course-progression">{p.modules.map((m,i)=><li><span class="feature-icon"><Icon name={m.icon}/></span><small>MODULE {i+1}</small><h3>{m.title}</h3><p>{m.summary}</p><SiteLink class="text-link" href={base+'curriculum/#module-'+(i+1)}>Explore the module <Icon name="arrowRight"/></SiteLink></li>)}</ol></div></section>
<section class="container section"><div class="section-heading"><div><p class="eyebrow">PLANNED LEARNING PROJECTS</p><h2>Prepare evidence, not just notes.</h2></div><SiteLink class="text-link" href={base+'projects/'}>Explore all projects <Icon name="layers"/></SiteLink></div><div class="three-grid">{p.projects.map((project,i)=><article class="feature"><span class="feature-icon"><Icon name={project.icon}/></span><h3>{project.title}</h3><p>{project.problem}</p><SiteLink class="text-link" href={base+'projects/#project-'+(i+1)}>Inside the project <Icon name="arrowRight"/></SiteLink></article>)}</div></section>
<section class="container section section-tight faq-wrap"><h2>Before you join</h2>{[['Who is this for?',p.audience+'. '+p.bridge],['What will I build or prepare?',p.projects.map(x=>x.title).join('; ')+'. These are planned learning exercises using suitable sample data and scenarios.'],['How are dates and delivery confirmed?','Enquire with your experience, goals and preferred learning mode. Fees, timing, trainer availability and final scope are agreed before joining.'],['Which learning path should I select?',p.scope]].map(([q,a])=><details class="faq"><summary>{q}<Icon name="plus"/></summary><p>{a}</p></details>)}</section>
</>}
{section==='curriculum'&&<section class="container section"><div class="inline-note"><Icon name="compass"/><p>{p.scope}</p></div><ModuleExplorer modules={p.modules} label={p.shortTitle}/></section>}
{section==='projects'&&<section class="container section"><div class="inline-note"><Icon name="flask"/><p>Planned learning exercises using sample or appropriately licensed data. These examples are not past student outcomes, client assignments or commitments to build a production system.</p></div>{p.projects.map((project,i)=><article id={'project-'+(i+1)} class="course-project"><div class="project-heading"><span class="feature-icon"><Icon name={project.icon}/></span><div><p class="eyebrow">PROJECT {i+1}</p><h2>{project.title}</h2><p>{project.problem}</p></div></div><ol class="project-flow" aria-label="Project workflow">{project.flow.map((step,j)=><li><small>0{j+1}</small><strong>{step}</strong>{j < project.flow.length - 1 && <Icon name="arrowRight"/>}</li>)}</ol><div class="lab-brief"><p class="eyebrow">THE PRACTICAL WALKTHROUGH</p><p>{project.practice}</p></div><div class="two-grid"><div><h3>Failure cases to explore</h3><ul class="check-list">{project.failures.map(t=><li>{t}</li>)}</ul></div><div><h3>Evidence you’ll work towards</h3><ul class="check-list">{project.evidence.map(t=><li>{t}</li>)}</ul></div></div></article>)}</section>}
{section==='career-preparation'&&<><section class="container section"><p class="eyebrow">PRACTISE THE CONVERSATION</p><h2>{p.key==='leadership'?'Make your leadership decisions reviewable.':'Make your skills visible through your work.'}</h2><div class="preparation-grid">{p.preparation.map(([title,copy],i)=><article class="feature"><span class="feature-icon"><Icon name={['message','target','folder','shield'][i%4]}/></span><h3>{title}</h3><p>{copy}</p><p class="prep-evidence"><strong>Practice evidence</strong><br/>Use one course project to demonstrate this capability and explain what you would improve.</p></article>)}</div></section><section class="container section section-tight"><div class="readiness-card"><h2>Your review pack</h2><ul class="check-list">{p.projects.flatMap(x=>x.evidence.slice(0,1)).map(t=><li>{t}</li>)}<li>A concise account of assumptions, limitations and next steps</li></ul><p>Preparation supports learning and communication. It does not promise employment, promotion, certification or a particular business result.</p></div></section></>}
<ProgramEnd track={p.key}/>
</Layout>

<style>.entry-paths,.preparation-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px}.entry-paths h3,.preparation-grid h3{margin:20px 0 12px}.course-progression{padding:0;list-style:none;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px;margin-top:28px}.course-progression li{background:white;border:1px solid #e1e6ef;border-radius:12px;padding:25px}.course-progression small{display:block;margin:18px 0 10px;color:#6550df;font-size:.65rem}.course-progression h3{font-size:1.1rem;margin-bottom:12px}.course-progression p{font-size:.84rem}.course-curriculum{display:grid;grid-template-columns:260px minmax(0,1fr);gap:34px;margin-top:35px}.course-module-nav{position:sticky;top:95px;align-self:start}.course-module-nav a{display:flex;gap:15px;align-items:flex-start;font-size:.77rem;color:#17254e;padding:16px 0;border-bottom:1px solid #e3e7ef}.course-module-nav a :global(.icon){color:#6247ef;flex-shrink:0}.course-module-nav a[aria-current]{background:#f3f4fb;box-shadow:inset 3px 0 #6550df;padding-left:10px}.course-module-nav a:focus-visible{outline:3px solid #6550df;outline-offset:3px}.course-project{border:1px solid #dfe5ee;background:#fff;border-radius:15px;padding:32px;margin-top:28px;scroll-margin-top:100px}.project-heading{display:flex;align-items:flex-start;gap:20px}.project-heading h2{font-size:1.7rem;margin:8px 0 14px}.project-flow{list-style:none;padding:0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px;margin:28px 0}.project-flow li{position:relative;border:1px solid #dce5ef;border-radius:10px;background:#f5f8fc;padding:18px}.project-flow small{display:block;color:#6550df;margin-bottom:10px}.project-flow strong{font-size:.85rem}.project-flow :global(.icon){position:absolute;right:-19px;top:45%;color:#6550df}.preparation-grid{margin-top:28px}.prep-evidence{border-top:1px solid #e2e7ee;padding-top:18px;margin-top:22px;font-size:.8rem}@media(max-width:850px){.course-progression{grid-template-columns:repeat(2,minmax(0,1fr))}.course-curriculum{grid-template-columns:1fr}.course-module-nav{position:static;display:grid;grid-template-columns:1fr 1fr;gap:0 18px}.course-module-nav .eyebrow{grid-column:1/-1}.project-flow{grid-template-columns:1fr 1fr}.project-flow :global(.icon){display:none}}@media(max-width:560px){.entry-paths,.preparation-grid,.course-progression{grid-template-columns:1fr}.course-project{padding:22px}.project-heading{gap:12px}.project-heading h2{font-size:1.4rem}.project-flow{gap:10px}.project-flow li{padding:14px}.course-module-nav a{font-size:.71rem;gap:9px}}
</style>
