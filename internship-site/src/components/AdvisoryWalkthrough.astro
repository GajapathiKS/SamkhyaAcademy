---
import {venture} from '../data/venture';
import Icon from './Icon.astro';
const documents=['Opportunity brief: user, situation, workaround, consequence and three assumptions.','Evidence matrix: interview observation, evidence for/against, confidence and next question.','Model canvas: customer, value, channels, costs and revenue assumptions.','MVP scope: one user journey, acceptance tests, exclusions and delivery responsibilities.','Pilot plan: participants, consent, onboarding, support and stop conditions.','Learning report: baseline, observed results, incidents and changes to test.','Readiness checklist: repeatability, operating capacity, risks and next investment decision.'];
---
<section class="walkthrough" aria-labelledby="walkthrough-title"><p class="eyebrow">ILLUSTRATIVE ADVISORY WORKFLOW</p><h2 id="walkthrough-title">Walk an idea through seven decisions.</h2><p>This is an example you can explore. It does not show your progress or create an engagement.</p><div class="stage-buttons" role="group" aria-label="Choose an example advisory stage">{venture.stages.map((s,i)=><button type="button" data-stage={i} aria-pressed={i===0} aria-controls={`walk-panel-${i}`}><Icon name={s.icon}/><span>{i+1}. {s.title}</span></button>)}</div>{venture.stages.map((s,i)=><article class="walk-panel" id={`walk-panel-${i}`} hidden={i!==0}><div class="walk-grid"><div><p class="eyebrow">FOUNDER ACTION</p><h3>{s.summary}</h3><p>{s.work}</p><p class="eyebrow">ACADEMY SUPPORT</p><ul>{s.topics.map(t=><li>{t}</li>)}</ul></div><div class="document-preview"><Icon name="folder"/><p class="eyebrow">EXAMPLE WORKING DOCUMENT</p><h3>{s.output}</h3><p>{documents[i]}</p><p><strong>Deliverable to review:</strong> {s.lab}</p></div></div><div class="decision"><h3>{s.question}</h3><p>{s.criteria.join(' · ')}</p><div role="group" aria-label="Explore example decisions"><button type="button" data-decision="proceed">Proceed</button><button type="button" data-decision="revise">Revise</button><button type="button" data-decision="pause">Pause</button></div><p class="decision-answer" role="status">Choose a decision to see what it could mean.</p></div></article>)}</section>
<script>
const root=document.querySelector('.walkthrough')!;root.querySelectorAll<HTMLButtonElement>('[data-stage]').forEach(button=>button.addEventListener('click',()=>{root.querySelectorAll('[data-stage]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));root.querySelectorAll<HTMLElement>('.walk-panel').forEach((panel,i)=>panel.hidden=i!==Number(button.dataset.stage));}));root.querySelectorAll<HTMLButtonElement>('[data-decision]').forEach(b=>b.addEventListener('click',()=>{const copy={proceed:'Example: the evidence supports a next experiment. Agree its scope, owner and review point before moving forward.',revise:'Example: evidence is incomplete or contradicts an assumption. Update the brief and run a smaller test before committing more effort.',pause:'Example: timing, demand or capacity is insufficient. Document the learning and the conditions that would justify revisiting it.'};b.closest('.decision')!.querySelector('.decision-answer')!.textContent=copy[b.dataset.decision as keyof typeof copy];}));
</script>
<style>.walkthrough{padding:30px;background:linear-gradient(120deg,#eff6fd,#fff);border:1px solid #dbe5f1;border-radius:20px;margin-bottom:40px}.stage-buttons{display:flex;flex-wrap:wrap;gap:8px;margin:24px 0}.stage-buttons button,.decision button{font:inherit;font-size:.8rem;padding:10px 14px;border:1px solid #b7cce2;border-radius:8px;background:white;color:#173c68;cursor:pointer;display:inline-flex;align-items:center;gap:8px}.stage-buttons button[aria-pressed=true]{background:#173c68;color:white}.walk-grid{display:grid;grid-template-columns:1fr 1fr;gap:28px}.walk-panel[hidden]{display:none}.document-preview{padding:26px;background:white;border:1px solid #dbe5f1;box-shadow:8px 8px 0 #dceafa;border-radius:6px 22px 6px 6px}.walk-panel p,.walk-panel ul{margin-block:14px}.decision{border-top:1px solid #cfdfef;margin-top:26px;padding-top:20px}.decision button{margin-right:8px}.decision-answer{min-height:3.5em}.walkthrough button:focus-visible{outline:3px solid #765cf6;outline-offset:3px}@media(max-width:700px){.walk-grid{grid-template-columns:1fr}.walkthrough{padding:20px}.stage-buttons{display:grid;grid-template-columns:1fr 1fr}.stage-buttons button{font-size:.7rem;padding:8px}}
</style>
