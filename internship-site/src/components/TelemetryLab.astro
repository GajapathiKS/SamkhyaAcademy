---
import Icon from './Icon.astro';
---
<div class="telemetry-lab"><div class="telemetry-head"><div><p class="eyebrow">GROUND VIEW / SYNTHETIC TELEMETRY</p><h3>Good telemetry tells you when not to trust it.</h3></div><Icon name="radio"/></div><div class="telemetry-grid"><div><label for="telemetry-scenario">Explore a test scenario</label><select id="telemetry-scenario"><option value="normal">Normal contact</option><option value="missing">Missing packet</option><option value="stale">Stale sensor reading</option><option value="energy">Low-energy warning</option></select><div class="packet"><span>PACKET / JSON FIXTURE</span><pre id="packet-content">&#123; "seq": 1042,
  "battery_v": 7.6,
  "valid": true,
  "age_s": 1 &#125;</pre></div></div><div class="operator-view" aria-live="polite"><span id="telemetry-status" class="telemetry-status">CONTACT RECEIVED</span><div class="trace" aria-hidden="true"><svg viewBox="0 0 420 100"><path d="M0 80H420M0 50H420M0 20H420" stroke="#dce5ef" fill="none"/><path id="signal-trace" d="M0 58L40 54L80 57L120 43L160 47L200 38L240 42L280 29L320 34L360 25L420 30" fill="none" stroke="#28659d" stroke-width="3"/></svg></div><h4 id="operator-title">Show the measurement and its freshness.</h4><p id="operator-copy">The operator can inspect the value, units and sequence. A received reading is only useful when its meaning is clear.</p><div class="operator-action"><Icon name="shield"/><p id="operator-action">Record the packet; continue the simulated contact plan.</p></div></div></div></div>
<script>const scenarios={normal:{packet:'{ "seq": 1042,\n  "battery_v": 7.6,\n  "valid": true,\n  "age_s": 1 }',status:'CONTACT RECEIVED',title:'Show the measurement and its freshness.',copy:'The operator can inspect the value, units and sequence. A received reading is only useful when its meaning is clear.',action:'Record the packet; continue the simulated contact plan.'},missing:{packet:'Received: 1040, 1041, 1043\nMissing:  1042\nValue:    unknown',status:'SEQUENCE GAP',title:'A gap is evidence. Keep it visible.',copy:'The receiver flags the missing packet rather than inventing a replacement measurement. A later packet does not prove the missing value was safe.',action:'Record the gap and follow the documented retry policy.'},stale:{packet:'{ "seq": 1042,\n  "battery_v": 7.6,\n  "valid": true,\n  "age_s": 600 }',status:'STALE READING',title:'A valid format can still hold old information.',copy:'In this fixture, the reading exceeds the assumed 60-second freshness limit. Preserve it as historical data, not current system state.',action:'Mark current state unknown; request fresh telemetry.'},energy:{packet:'{ "seq": 1042,\n  "energy_mode": "low",\n  "payload": "paused",\n  "review": "required" }',status:'LOW-ENERGY SCENARIO',title:'Reduce activity before adding autonomy.',copy:'This synthetic scenario enters an agreed low-energy mode. The response is a teaching example, not a hardware voltage threshold.',action:'Pause the simulated payload; require human review before resuming.'}};const select=document.querySelector<HTMLSelectElement>('#telemetry-scenario');select?.addEventListener('change',()=>{const s=scenarios[select.value as keyof typeof scenarios];for(const [id,value] of Object.entries({'packet-content':s.packet,'telemetry-status':s.status,'operator-title':s.title,'operator-copy':s.copy,'operator-action':s.action}))document.getElementById(id)!.textContent=value;document.querySelector('.operator-view')!.setAttribute('data-warning',String(select.value!=='normal'));});</script>
<style>.telemetry-lab{border:1px solid #d9e3ef;border-radius:14px;overflow:hidden;background:#fff}.telemetry-head{display:flex;justify-content:space-between;gap:20px;padding:25px 28px;background:#edf3f9}.telemetry-head h3{font-size:1.2rem}.telemetry-head>:global(.icon){color:#2c6399;width:32px;height:32px;flex:none}.telemetry-grid{display:grid;grid-template-columns:1fr 1.2fr;gap:28px;padding:28px}.telemetry-grid label{display:block;font-size:.75rem;margin-bottom:10px}.telemetry-grid select{width:100%;font:inherit;font-size:.8rem;padding:12px;border:1px solid #b6c9dd;border-radius:6px;background:#fff;color:#12304f}.packet{background:#0d223d;color:#b4e4eb;border-radius:9px;margin-top:18px;padding:20px}.packet>span{font-size:.6rem;letter-spacing:.1em}.packet pre{font-size:.78rem;line-height:1.8;margin-top:14px;white-space:pre-wrap;overflow-wrap:anywhere}.telemetry-status{font-size:.62rem;color:#195e65;background:#edf8f4;padding:7px 10px;border-radius:4px}.operator-view[data-warning=true] .telemetry-status{color:#754207;background:#fff3dc}.trace{margin:20px 0}.trace svg{width:100%;max-height:100px}.operator-view h4{font-size:1rem;margin:15px 0}.operator-view p{font-size:.8rem}.operator-action{display:flex;gap:12px;padding-top:18px;margin-top:18px;border-top:1px solid #e2e6ef}.operator-action :global(.icon){flex:none;color:#27618f}@media(max-width:650px){.telemetry-grid{grid-template-columns:1fr;padding:20px}.telemetry-head{padding:20px}}</style>
