---
import InternshipAIHighlights from '../../../components/InternshipAIHighlights.astro';
import Layout from '../../../layouts/ProgramLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import CTA from '../../../components/CTA.astro';
import Icon from '../../../components/Icon.astro';
import { modules } from '../../../data/curriculum';
---
<Layout track="internship" section="curriculum" title="What you’ll learn in AI engineering" description="Explore the skills, tools, and outcomes of the AI Engineering Training Internship: Python, full-stack foundations, generative AI, RAG, agents, and DSA.">
<PageHero slot="hero" eyebrow="What you’ll learn" title="From Python foundations to RAG and AI agents." description="Learn to build AI that can find evidence, use tools, and work within clear boundaries. Start with the software foundations, then connect the capabilities through guided projects." image="ai-engineering" imageAlt="AI-generated learning scene with learners collaborating; not actual academy participants" caption="From software foundations to thoughtful AI systems."><div class="pill-row"><span>16-week program</span><span>Beginner friendly</span><span>DSA throughout</span></div></PageHero><InternshipAIHighlights />
<section class="container section learning-intro"><p class="eyebrow">THE BIG PICTURE</p><h2>Learn the pieces.<br />Understand the connections.</h2><p>You’ll work towards building complete applications, not collecting disconnected tool names. These public modules describe the capabilities you’ll develop; enquire for the detailed syllabus and teaching arrangements.</p></section>
<section class="container curriculum-layout public-modules"><nav class="module-nav" aria-label="Learning modules"><p class="eyebrow">EXPLORE THE MODULES</p>{modules.map((m,i) => <a href={`module-${i+1}`.replace(/^/,'#')}><Icon name={m.icon} />{m.label}</a>)}</nav><div>{modules.map((m,i) => <article id={`module-${i+1}`} class="module"><div class="module-top"><span class="module-index"><Icon name={m.icon} /></span><div><p class="eyebrow">{m.label}</p><h2>{m.title}</h2></div></div><p class="module-description">{m.description}</p><div class="tags">{m.tools.map(t => <span>{t}</span>)}</div><h3>Capabilities you’ll work towards</h3><ul class="check-list">{m.topics.map(t => <li>{t}</li>)}</ul><div class="exercise"><p class="eyebrow">THE OUTCOME</p><p>{m.outcome}</p></div><p class="dsa-note"><strong>How it connects /</strong> {m.connection}</p></article>)}</div></section>
<section class="tinted section"><div class="container two-grid"><div><p class="eyebrow">ONE SKILL THAT RUNS THROUGH IT ALL</p><h2>Learn to solve the problem<br />before choosing the tool.</h2><p>DSA practice strengthens how you break a problem down, organize information, and compare solutions. It supports both the software you build and the way you explain it.</p><a class="text-link" href="/programs/ai-engineering-internship/career-preparation/">See the problem-solving approach <Icon name="arrowRight" /></a></div><div class="capability-map">{[['code','Python reasoning'],['network','Data structures'],['search','Complexity & trade-offs'],['message','Clear explanations']].map(([icon,label]) => <div><Icon name={icon} /><span>{label}</span></div>)}</div></div></section><CTA /></Layout>
