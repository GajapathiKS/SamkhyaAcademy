---
import Layout from '../../../layouts/ProgramLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import CTA from '../../../components/CTA.astro';
import Icon from '../../../components/Icon.astro';
import ProjectMockup from '../../../components/ProjectMockup.astro';
import { projects } from '../../../data/curriculum';
---
<Layout track="internship" section="projects" title="Inside your AI engineering projects" description="Explore four planned learning projects in detail: their users, problems, example interfaces, architecture, features, and portfolio deliverables.">
<PageHero slot="hero" eyebrow="Projects" title="Start with a real problem. Build a thoughtful answer." description="A portfolio becomes meaningful when you can explain who a project helps, how it works, and what you learned along the way." image="ai-engineering" imageAlt="AI-generated learning scene with learners collaborating; not actual academy participants" caption="Ideas become interfaces. Interfaces become experiences."><p class="caption">Planned learning projects and illustrative concepts—not live applications, client assignments, or past student results.</p></PageHero>
<nav class="container project-jump" aria-label="Project stories">{projects.map(p => <a href={`#${p.id}`}><span>{p.number}</span><Icon name={p.icon} />{p.title}</a>)}</nav>
<section class="container section project-stories">{projects.map(p => <article id={p.id} class={`project-story ${p.color}`}><div class="story-heading"><div><p class="eyebrow">PROJECT {p.number} / {p.stage}</p><h2>{p.title}</h2><p>{p.subtitle}</p></div><span class="story-icon"><Icon name={p.icon} /></span></div><div class="story-intro"><div><h3>The idea</h3><p>{p.description}</p><div class="audience-box"><Icon name="users" /><div><strong>Who it’s for</strong><p>{p.user}</p></div></div><h3>The problem worth solving</h3><p>{p.problem}</p></div><ProjectMockup id={p.id} /></div><div class="story-columns"><div><p class="eyebrow">PICTURE THE EXPERIENCE</p><h3>A student’s journey</h3><ol class="numbered-steps">{p.journey.map(s => <li>{s}</li>)}</ol></div><div><p class="eyebrow">THE BUILDING BLOCKS</p><h3>Features to bring it to life</h3><ul class="check-list">{p.features.map(s => <li>{s}</li>)}</ul></div></div><div class="architecture-strip"><p class="eyebrow">HOW THE PIECES CONNECT</p><div>{p.flow.map((step,i) => <><span><Icon name={i === 0 ? p.icon : i === 1 ? 'network' : 'check'} />{step}</span>{i<2 && <Icon name="arrowRight" />}</>)}</div></div><div class="story-columns"><div><p class="eyebrow">THINK LIKE AN ENGINEER</p><h3>The interesting challenge</h3><p>{p.challenge}</p><blockquote><Icon name="message" />{p.discussion}</blockquote></div><div><p class="eyebrow">MAKE YOUR LEARNING VISIBLE</p><h3>What goes into your portfolio</h3><ul class="check-list">{p.deliverables.map(d => <li>{d}</li>)}</ul></div></div><div class="proof-panel"><Icon name="target" /><div><p class="eyebrow">YOUR “LET ME SHOW YOU” MOMENT</p><p>{p.proof}</p></div></div></article>)}</section>
<section class="tinted section"><div class="container"><div class="section-heading"><div><p class="eyebrow">WHAT MAKES A PROJECT YOURS?</p><h2>The decisions behind the demo.</h2></div><p>The interface is the beginning of the story. Your understanding is what gives it depth.</p></div><div class="three-grid">{[['search','Evidence','Show the tests and evaluation questions you used. Explain what worked and where the result needs more attention.'],['compass','Judgment','Discuss why you chose a tool or approach, what you kept simple, and what you would change next.'],['message','Communication','Give another person a clear way to run the code, follow the architecture, and understand the limitations.']].map(([icon,title,copy]) => <article class="feature"><span class="feature-icon"><Icon name={icon} /></span><h3>{title}</h3><p>{copy}</p></article>)}</div></div></section><CTA /></Layout>
