---
import {career} from '../../../data/internship-career';
import Icon from '../../../components/Icon.astro';
import PageDepth from '../../../components/PageDepth.astro';
import Layout from '../../../layouts/ProgramLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import CTA from '../../../components/CTA.astro';
---
<Layout track="internship" section="career-preparation" title="DSA and career preparation" description="Practise DSA in Python, strengthen your GitHub portfolio, debug with confidence, and learn to explain your AI projects in technical interviews."><PageHero slot="hero" image="ai-engineering" imageAlt="AI-generated learning scene with learners collaborating; not actual academy participants" caption="Build the skill. Document the evidence. Explain the work." eyebrow="Career preparation" title="Build the skill. Then learn to explain it." description="A project gets more useful when you can talk through the problem, the code, and the trade-offs. Practise that alongside technical foundations." /><section class="container section"><div class="section-heading"><div><p class="eyebrow">DSA, THROUGHOUT THE PROGRAM</p><h2>Train your problem-solving muscle.</h2></div><p>Use Python to reason about a problem, choose a structure, test edge cases, and explain complexity.</p></div><div class="three-grid">{career.foundations.map(c=><article class="feature"><span class="feature-icon"><Icon name={c.icon} /></span><h3>{c.title}</h3><p>{c.description}</p></article>)}</div></section><section class="tinted section"><div class="container two-grid"><div><p class="eyebrow">MAKE YOUR WORK UNDERSTANDABLE</p><h2>Your GitHub should<br />tell the story.</h2><p>A useful repository helps someone run your project and understand why you built it that way.</p><a class="text-link" href="/programs/ai-engineering-internship/projects/">Explore the portfolio projects <Icon name="arrowRight" /></a></div><div class="portfolio-check"><h3>Inside a strong project README</h3><ul class="check-list"><li>The problem and the intended user</li><li>Setup instructions and environment variables</li><li>A simple architecture and data-flow diagram</li><li>Tests, evaluation results, and a short demo</li><li>Limitations, trade-offs, and next improvements</li></ul></div></div></section><section class="container section"><p class="eyebrow">PRACTISE THE CONVERSATION</p><h2>Get comfortable with “why?”</h2><div class="three-grid interview-grid">{career.interview.map(c=><article><span>{c.number}</span><h3>{c.title}</h3><p>{c.description}</p></article>)}</div><p class="caption">Career preparation supports your learning and interview readiness. It does not guarantee employment or placement.</p></section><PageDepth page="career" /><CTA /></Layout>
