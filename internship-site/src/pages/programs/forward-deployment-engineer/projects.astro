---
import Layout from '../../../layouts/ProgramLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import Icon from '../../../components/Icon.astro';
import Art from '../../../components/Art.astro';
import ProgramEnd from '../../../components/ProgramEnd.astro';
import {fde} from '../../../data/fde';
---
<Layout track="fde" section="projects" title="FDE projects and delivery capstone" description="Explore a permission-aware knowledge assistant, an approved operations workflow, and an integrated AI delivery capstone with architecture and review criteria.">
<PageHero slot="hero" eyebrow="Projects" title="The demo is the beginning. The evidence tells the story." description="Build towards three connected learning projects. Each gives you a problem to frame, a system to explain, and behaviour to verify." image="fde-learning" imageAlt="AI-generated learning scene with learners collaborating; not actual academy participants" caption="Planned learning projects. Illustrative scenarios. Reviewable evidence." />
<nav class="container project-jump" aria-label="FDE project stories">{fde.projects.map((p,i)=><a href={`#${p.id}`}><span>0{i+1}</span><Icon name={p.icon} />{p.title}</a>)}</nav>
<section class="container section project-stories">{fde.projects.map(p=><article class="project-story" id={p.id}><div class="story-heading"><div><p class="eyebrow">{p.tag}</p><h2>{p.title}</h2><p>{p.summary}</p></div><span class="story-icon"><Icon name={p.icon} /></span></div><div class="story-intro"><div><h3>The problem worth solving</h3><p>{p.problem}</p><div class="audience-box"><Icon name="users" /><div><strong>The intended user</strong><p>{p.user}</p></div></div></div><Art name={p.image} alt={`Concept illustration for ${p.title}`} /></div><div class="fde-architecture"><p class="eyebrow">HOW THE SYSTEM FITS TOGETHER</p><ol>{p.flow.map((step,i)=><li><span>0{i+1}</span><strong>{step}</strong>{i < p.flow.length - 1 && <Icon name="arrowRight" />}</li>)}</ol></div><div class="story-columns"><div><p class="eyebrow">PICTURE THE EXPERIENCE</p><h3>The user journey</h3><ol class="numbered-steps">{p.journey.map(t=><li>{t}</li>)}</ol></div><div><p class="eyebrow">TOOLS WITH CLEAR BOUNDARIES</p><h3>Who does what?</h3><ul class="check-list">{p.responsibilities.map(t=><li>{t}</li>)}</ul></div></div><div class="story-columns"><div><p class="eyebrow">TEST THE DIFFICULT PATH</p><h3>Failure cases to demonstrate</h3><ul class="check-list">{p.failures.map(t=><li>{t}</li>)}</ul></div><div><p class="eyebrow">MAKE THE WORK REVIEWABLE</p><h3>Portfolio evidence</h3><ul class="check-list">{p.evidence.map(t=><li>{t}</li>)}</ul></div></div><div class="proof-panel"><Icon name="target" /><div><p class="eyebrow">THE REVIEW STANDARD</p><p>{p.review}</p></div></div></article>)}</section>
<section class="container fit-panel"><p class="eyebrow">A LEARNING ENVIRONMENT</p><h2>Real engineering questions.<br />Illustrative project scenarios.</h2><p>Use suitable sample data and simulated enterprise adapters. These are planned learning projects, not live client assignments. Project completion alone does not establish production readiness or guarantee employment.</p><a class="text-link" href="/programs/forward-deployment-engineer/career-preparation/">Turn the work into a delivery case study <Icon name="arrowRight" /></a></section><ProgramEnd track="fde" />
</Layout>
