---
import Layout from '../../../layouts/ProgramLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import Icon from '../../../components/Icon.astro';
import ToolGrid from '../../../components/ToolGrid.astro';
import ProgramEnd from '../../../components/ProgramEnd.astro';
import {fde} from '../../../data/fde';
---
<Layout track="fde" section="curriculum" title="FDE curriculum and tools" description="Explore eight Forward Deployment Engineering modules with topics, tools, practical work, deliverables, and review criteria.">
<PageHero slot="hero" eyebrow="Curriculum" title="Build the capability. Understand the whole system." description="Eight connected modules take your existing software skills into AI application engineering, production operations, and customer-facing delivery." image="fde-learning" imageAlt="AI-generated learning scene with learners collaborating; not actual academy participants" caption="A curriculum built around engineering responsibilities." />
<section class="container section"><div class="section-heading"><div><p class="eyebrow">WHAT YOU WILL LEARN</p><h2>Open a module.<br />See the work behind it.</h2></div><p>Each module connects concepts to practical work and reviewable evidence. The readiness bridge is optional; the remaining modules form the core journey. Batch timing will be announced separately.</p></div><div class="fde-curriculum"><nav class="module-nav" aria-label="FDE curriculum modules"><p class="eyebrow">EXPLORE THE MODULES</p>{fde.modules.map((m,i)=><a href={`#module-${i+1}`}><Icon name={m.icon} /><span>{m.title}</span></a>)}</nav><div class="module-stack">{fde.modules.map((m,i)=><details id={`module-${i+1}`} class="fde-module" open={i===0}><summary><span class="module-index"><Icon name={m.icon} /></span><span><small>MODULE 0{i+1} / {m.label}</small><h2>{m.title}</h2><span class="module-summary">{m.summary}</span></span><Icon name="plus" /></summary><div class="module-details"><div class="two-grid"><div><h3>Topics you’ll explore</h3><ul class="check-list">{m.topics.map(t=><li>{t}</li>)}</ul></div><div><h3>Tools and their purpose</h3><ul class="tool-list">{m.tools.map(t=><li><Icon name="code" /><span>{t}</span></li>)}</ul></div></div><div class="lab-brief"><p class="eyebrow">PRACTICAL WORK</p><p>{m.practice}</p></div><div class="two-grid"><div><h3>Deliverables</h3><ul class="check-list">{m.deliverables.map(t=><li>{t}</li>)}</ul></div><div><h3>Review criteria</h3><ul class="check-list">{m.criteria.map(t=><li>{t}</li>)}</ul></div></div><div class="module-question"><Icon name="message" /><p><strong>Be ready to explain:</strong> {m.question}</p></div></div></details>)}</div></div></section>
<section class="tinted section"><div class="container"><p class="eyebrow">THE REFERENCE STACK</p><h2>Learn the responsibility, not just the name.</h2><ToolGrid /><div class="inline-note"><Icon name="shield" /><p>Labs keep model credentials on the server. Recorded responses, suitable sample data, and simulated enterprise services make practice repeatable. Specific provider versions and final prerequisites are confirmed before teaching.</p></div></div></section>
<section class="container section two-grid"><div><p class="eyebrow">BRING YOUR ENGINEERING BACKGROUND</p><h2>Python in the lab.<br />Patterns across stacks.</h2><p>Engineers using .NET, Java, or TypeScript can apply the same API contracts, identity boundaries, retrieval patterns, and release practices. The reference labs use Python; integration discussions show where an existing backend connects to the AI service.</p></div><div class="readiness-card"><h3>One integration, clearly defined.</h3><ol class="numbered-steps"><li>Your existing application sends a typed request with user context.</li><li>The AI service validates input and retrieves permitted evidence.</li><li>A structured result returns with citations or an explicit limitation.</li><li>Your application presents the result and owns its business permissions.</li></ol></div></section><ProgramEnd track="fde" />
</Layout>
<script>
  function revealModule() { const id=decodeURIComponent(location.hash.slice(1)); const target=document.getElementById(id); if(target instanceof HTMLDetailsElement){target.open=true;requestAnimationFrame(()=>target.scrollIntoView({block:'start'}));} document.querySelectorAll('.fde-curriculum .module-nav a').forEach(a=>{if(a.getAttribute('href')===location.hash)a.setAttribute('aria-current','location');else a.removeAttribute('aria-current');}); }
  revealModule(); window.addEventListener('hashchange',revealModule);
</script>

<style>.fde-curriculum .module-nav{align-self:start}.fde-curriculum .module-nav>.eyebrow{margin:0 0 18px;grid-column:1/-1}.fde-curriculum .module-nav a{font-weight:400;color:#17254e;gap:16px;padding:15px 0;border-bottom:1px solid #e3e7f0;font-size:.78rem;line-height:1.65}.fde-curriculum .module-nav a>span:not(.icon){color:inherit;font-weight:inherit}.fde-curriculum .module-nav a :global(.icon){color:#6247ef;width:19px;height:19px;flex-shrink:0}.fde-curriculum .module-nav a:hover{color:#4931ee;background:#f6f5fc}.fde-curriculum .module-nav a[aria-current="location"]{color:#17254e;background:#f3f4fb;box-shadow:inset 3px 0 #6550df;padding-left:10px}.fde-curriculum .module-stack{margin-top:0}.fde-curriculum .module-nav a:focus-visible{outline:3px solid #6550df;outline-offset:3px}@media(max-width:850px){.fde-curriculum .module-nav a{font-size:.73rem;gap:10px}}</style>
