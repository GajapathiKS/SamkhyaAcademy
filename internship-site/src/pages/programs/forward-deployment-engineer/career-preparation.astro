---
import Layout from '../../../layouts/ProgramLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import Icon from '../../../components/Icon.astro';
import ProgramEnd from '../../../components/ProgramEnd.astro';
import {fde} from '../../../data/fde';
---
<Layout track="fde" section="career-preparation" title="FDE career and delivery preparation" description="Practise architecture interviews, customer discovery, incident debugging, technical demonstrations, tradeoff discussions, and delivery case studies.">
<PageHero slot="hero" eyebrow="Career preparation" title="Explain your decisions. Show your engineering judgment." description="Practise the conversations that connect an AI system to the people evaluating, using, and maintaining it." image="fde-learning" imageAlt="AI-generated learning scene with learners collaborating; not actual academy participants" caption="Architecture. Evidence. Communication. Ownership." />
<section class="container section"><div class="section-heading"><div><p class="eyebrow">PREPARE FOR THE DELIVERY CONVERSATION</p><h2>Six ways to make your experience visible.</h2></div><p>Build on your existing software background with practice grounded in the FDE projects. Show how you reason, investigate, and communicate.</p></div><div class="career-grid">{fde.career.map(c=><article class="career-card"><span class="feature-icon"><Icon name={c.icon} /></span><p class="eyebrow">{c.subtitle}</p><h3>{c.title}</h3><p>{c.practice}</p><div class="career-evidence"><strong>Evidence to prepare</strong><p>{c.evidence}</p></div></article>)}</div></section>
<section class="tinted section"><div class="container two-grid"><div><p class="eyebrow">YOUR DELIVERY CASE STUDY</p><h2>A portfolio that goes<br />beyond the interface.</h2><p>Help a reviewer follow the full story: why the problem mattered, what you built, how you tested it, and what another team would need to know.</p><a class="button" href="/programs/forward-deployment-engineer/projects/">Explore the delivery projects <Icon name="arrowRight" /></a></div><div class="portfolio-check"><h3>The case-study structure</h3><ol class="numbered-steps"><li>Problem, user, constraints, and acceptance criteria.</li><li>Architecture, data boundaries, and rejected alternatives.</li><li>Implementation, tests, and the parts you own.</li><li>Evaluation results, failed cases, latency, and cost.</li><li>Deployment, recovery, handover, and next decisions.</li></ol></div></div></section>
<section class="container section"><p class="eyebrow">PRACTISE THE WALKTHROUGH</p><h2>One system. Three conversations.</h2><div class="three-grid interview-grid"><article><span>01</span><h3>With a customer</h3><p>Explain which workflow the pilot helps, show the experience, and identify the evidence needed for the next decision.</p></article><article><span>02</span><h3>With an engineer</h3><p>Trace a request, explain the trust boundaries, and show how a rejected action or failed dependency is handled.</p></article><article><span>03</span><h3>With an operator</h3><p>Walk through configuration, health checks, a failure investigation, and recovery using the runbook.</p></article></div><p class="caption">These learning activities support technical communication and interview preparation. They do not promise employment, placement, or a specific role.</p></section><ProgramEnd track="fde" />
</Layout>
