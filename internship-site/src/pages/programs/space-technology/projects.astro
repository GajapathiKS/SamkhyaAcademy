---
import PageHero from '../../../components/PageHero.astro';
import Layout from '../../../layouts/ProgramLayout.astro';
import ProgramEnd from '../../../components/ProgramEnd.astro';
import Icon from '../../../components/Icon.astro';
import MissionLab from '../../../components/MissionLab.astro';
import TelemetryLab from '../../../components/TelemetryLab.astro';
import {space} from '../../../data/space';
const teams=[['wrench','Mechanical','Envelope, load paths and thermal assumptions'],['battery','Electrical','Peak loads, energy and interface limits'],['cpu','Embedded & software','State, telemetry, commands and recovery'],['brain','AI & data','Baselines, anomaly evidence and bounded actions']];
const icons=['orbit','radio','satellite'];
const checkpoints=[['Mission brief','Budget review','Interface agreement'],['Schema review','Fault injection','Ground demonstration'],['Integration rehearsal','Evidence review','Handover package']];
---
<Layout track="space" section="projects" title="Space technology mission lab & projects" description="Explore interactive educational mission budgets, synthetic telemetry scenarios and three space technology project walkthroughs.">
<PageHero slot="hero" eyebrow="SPACE TECHNOLOGY / PROJECT EXPERIENCE" title="From a mission idea to a system you can explain." description="Explore the engineering underneath an educational satellite concept. Change an assumption, follow the data and see what a design review needs to prove." image="space-tech" imageAlt="AI-generated learning scene with learners collaborating; not actual academy participants" caption="Educational concepts. Reviewable evidence."><nav class="project-jumps" aria-label="Space project milestones">{space.projects.map((_,i)=><a href={`#project-${i+1}`}><Icon name={icons[i]}/><span>Project 0{i+1}</span><Icon name="arrowDown"/></a>)}</nav></PageHero>
<section class="container"><MissionLab/></section>
<section class="container section"><p class="eyebrow">ONE TEAM / CONNECTED RESPONSIBILITIES</p><h2>Your subsystem is part of someone else’s design.</h2><div class="team-lanes">{teams.map(([icon,title,copy])=><article><Icon name={icon}/><h3>{title}</h3><p>{copy}</p></article>)}</div></section>
<section class="container section section-tight">{space.projects.map((p,i)=><article id={`project-${i+1}`} class="mission-project"><header><span class="project-emblem"><Icon name={icons[i]}/></span><div><p class="eyebrow">PLANNED LEARNING PROJECT / 0{i+1}</p><h2>{p.title}</h2><p>{p.problem}</p></div></header><div class="mission-pipeline" aria-label="Project architecture">{p.flow.map((step,j)=><div><span class="pipeline-index">0{j+1}</span><Icon name={['target','layers','cpu','chart','shield'][j]}/><strong>{step}</strong>{j < p.flow.length - 1 && <span class="pipeline-arrow"><Icon name="arrowRight"/></span>}</div>)}</div>{i===1&&<TelemetryLab/>}{i===2&&<div class="review-board"><div><p class="eyebrow">MISSION REVIEW / EVIDENCE MAP</p><h3>A working demo is one part of the story.</h3><p>Connect the requirement to the test and the result. Use each review to identify the next uncertainty.</p></div><ol>{[['file','Requirement','Detect invalid battery telemetry'],['flask','Test','Inject an invalid sensor fixture'],['chart','Evidence','Display unknown state; retain the log'],['users','Review','Explain the outcome and remaining limits']].map(([icon,title,copy])=><li><Icon name={icon}/><span><strong>{title}</strong>{copy}</span></li>)}</ol></div>}<div class="project-brief"><div><h3><Icon name="wrench"/>What you build</h3><p>{p.work}</p><h3><Icon name="flask"/>Test the uncomfortable case</h3><p>{p.failure}</p></div><div class="evidence-case"><p class="eyebrow">YOUR REVIEW PACKAGE</p><h3><Icon name="folder"/>Evidence you work towards</h3><p>{p.evidence}</p><ol>{checkpoints[i].map((step,n)=><li><span>{n+1}</span>{step}</li>)}</ol></div></div><footer class="project-limit"><Icon name="compass"/><p>Educational simulation or agreed ground-based prototype. Results support the stated test conditions; they do not establish flight qualification or launch readiness.</p></footer></article>)}</section><ProgramEnd track="space"/></Layout>
<style>.mission-heading{padding-block:36px 28px}.mission-heading h1{font-size:clamp(2rem,4vw,3.5rem);line-height:1.12;max-width:900px}.mission-heading>p:last-of-type{max-width:760px;margin-top:24px}.project-jumps{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}.project-jumps a{display:flex;align-items:center;gap:10px;padding:13px 16px;background:#fff;border:1px solid #dce4ef;border-radius:7px;font-size:.75rem}.project-jumps :global(.icon){color:#365e9f;width:18px;height:18px}.team-lanes{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-top:28px}.team-lanes article{padding:23px;border:1px solid #dce5ee;border-radius:9px;background:#fff}.team-lanes article>:global(.icon){width:30px;height:30px;color:#386897}.team-lanes h3{font-size:1rem;margin:18px 0 10px}.team-lanes p{font-size:.8rem}.mission-project{margin-bottom:42px;scroll-margin-top:100px;border:1px solid #dce4ee;border-radius:14px;overflow:hidden;background:white}.mission-project>header{display:flex;gap:23px;align-items:start;padding:32px;background:linear-gradient(110deg,#f1f6fb,#fff)}.mission-project h2{font-size:clamp(1.6rem,2.3vw,2.2rem)}.mission-project>header p:last-child{max-width:850px;margin-top:14px;font-size:.9rem}.project-emblem{display:grid;place-items:center;width:60px;height:60px;flex:none;background:#15375e;border-radius:12px;color:#a4e2ed}.project-emblem :global(.icon){width:30px;height:30px}.mission-pipeline{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:16px;padding:28px 32px}.mission-pipeline>div{position:relative;border:1px solid #dbe5ef;padding:17px;background:#f8fafc;border-radius:8px;display:flex;flex-direction:column;gap:12px}.mission-pipeline strong{font-size:.76rem;font-weight:500}.pipeline-index{font-size:.57rem;color:#52617b}.mission-pipeline :global(.icon){color:#386fa0}.pipeline-arrow{position:absolute;right:-18px;top:45%;z-index:1}.project-brief{padding:32px;display:grid;grid-template-columns:1.15fr 1fr;gap:35px}.project-brief h3{display:flex;gap:10px;align-items:center;font-size:1.05rem;margin:18px 0 14px}.project-brief h3 :global(.icon){color:#346a9a}.project-brief p{font-size:.85rem}.evidence-case{background:#f4f7fa;padding:24px;border-radius:9px}.evidence-case ol{list-style:none;padding:0;margin:22px 0 0}.evidence-case li{display:flex;align-items:center;gap:12px;font-size:.75rem;margin:12px 0}.evidence-case li span{border:1px solid #c0d2e3;border-radius:50%;width:24px;height:24px;display:grid;place-items:center;color:#34628e}.project-limit{display:flex;gap:12px;margin:0;padding:18px 32px;background:#fcfcfc;border-top:1px solid #e2e6ef}.project-limit p{font-size:.7rem}.project-limit :global(.icon){flex:none;color:#537294}.mission-project>:global(.telemetry-lab){margin:0 32px}.review-board{margin:0 32px;background:#112b4c;border-radius:12px;padding:30px;display:grid;grid-template-columns:1fr 1.2fr;gap:28px;color:#fff}.review-board h3{color:#fff;font-size:1.5rem}.review-board .eyebrow{color:#a6dfeb}.review-board p{color:#b9cee3;font-size:.8rem;margin-top:16px}.review-board ol{list-style:none;margin:0;padding:0}.review-board li{display:flex;gap:14px;padding:12px 0;border-bottom:1px solid #ffffff20;color:#d4e5f5;font-size:.76rem}.review-board li strong{display:block;color:#8cddd4;font-size:.63rem}.review-board li>:global(.icon){flex:none;color:#92d6e8}@media(max-width:850px){.team-lanes{grid-template-columns:1fr 1fr}.mission-pipeline{grid-template-columns:repeat(3,minmax(0,1fr))}.pipeline-arrow{display:none}.project-brief,.review-board{grid-template-columns:1fr}}@media(max-width:480px){.team-lanes{grid-template-columns:1fr 1fr;gap:10px}.team-lanes article{padding:16px}.mission-project>header{padding:22px 18px;flex-direction:column}.mission-pipeline{padding:20px 18px;grid-template-columns:1fr 1fr;gap:10px}.project-brief{padding:20px 18px;gap:15px}.mission-project>:global(.telemetry-lab),.review-board{margin:0 18px}.review-board{padding:22px 18px}.project-limit{padding:18px}.project-jumps a{width:100%}.project-jumps a span{flex:1}}</style>
