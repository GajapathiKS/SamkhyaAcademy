---
import SiteLink from '../../components/SiteLink.astro';
import ProgramComparison from '../../components/ProgramComparison.astro';
import Layout from '../../layouts/Layout.astro';
import ProgramCards from '../../components/ProgramCards.astro';
import Icon from '../../components/Icon.astro';
import '../../styles/programs.css';
---
<Layout title="Explore our programs" description="Compare six learning programs in software, machine learning, AI delivery, space systems and leadership, plus Venture Launchpad startup advisory.">
<section class="catalog-hero compact-catalog"><div class="container"><p class="eyebrow">FIND YOUR NEXT DIRECTION</p><h1>Explore our programs.</h1><p class="lede">Compare the audience, curriculum and practical projects for each learning path. Start with your experience and the work you want to do next, from a first application to AI delivery, space systems or leadership. Venture Launchpad offers a separate startup advisory journey.</p></div></section>
<section class="container catalog-list" aria-label="Programs"><ProgramCards /></section>
<section class="container fit-panel"><p class="eyebrow">CHOOSE BY THE WORK YOU WANT TO DO</p><h2>A clearer choice than a list of tools.</h2><div class="choice-grid">{[['Build a complete application','Full-Stack Development centres on the browser, APIs, databases and delivery. The internship uses those foundations as the starting point for generative AI.','/programs/full-stack-development/','Explore full-stack'],['Learn from data or build with LLMs?','Machine Learning focuses on training and evaluating predictive models. The AI internship introduces LLM applications, retrieval and supervised agents.','/programs/machine-learning/','Explore machine learning'],['Deliver AI or lead its adoption?','Engineering FDE is for software practitioners building solutions. FDE for Leaders is for people deciding where to invest, what to govern and how to adopt.','/programs/fde-for-leaders/','Explore leadership'],['Build across disciplines','Space Technology joins mission analysis, mechanical and electrical interfaces, software, telemetry and verification in an educational demonstrator.','/programs/space-technology/','Explore space systems'],['Develop an early venture','Venture Launchpad is a scoped advisory relationship. Work through customer evidence, an MVP and execution decisions rather than follow a fixed course timetable.','/venture-studio/','Explore startup advisory']].map(([title,copy,href,label])=><article><h3>{title}</h3><p>{copy}</p><SiteLink class="text-link" href={href}>{label}<Icon name="arrowRight"/></SiteLink></article>)}</div></section>
<ProgramComparison/></Layout>

<style>.choice-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px;margin-top:28px}.choice-grid article{border-top:1px solid #dce4ed;padding-top:20px}.choice-grid h3{font-size:1.1rem}.choice-grid p{font-size:.85rem;margin:12px 0 18px}@media(max-width:600px){.choice-grid{grid-template-columns:1fr}}.compact-catalog{padding:24px 0 20px;border:0}.compact-catalog h1{font-size:clamp(1.9rem,3vw,2.6rem);margin:10px 0 12px;line-height:1.15}.compact-catalog .lede{font-size:.95rem;max-width:820px;line-height:1.65}.catalog-list{padding-bottom:40px}.catalog-list :global(.catalog-image img){height:200px;aspect-ratio:auto;object-fit:cover}.catalog-list :global(.catalog-copy){padding:24px}.catalog-list :global(.catalog-copy h2){margin:12px 0;font-size:1.45rem}@media(max-width:560px){.catalog-list :global(.catalog-image img){height:170px}}@media(max-width:560px){.compact-catalog{padding:22px 0 18px}.compact-catalog .lede{font-size:.86rem}}.fit-panel{margin-bottom:64px}@media(max-width:600px){.fit-panel{margin-bottom:40px}}</style>
