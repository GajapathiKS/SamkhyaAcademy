---
import SiteLink from '../components/SiteLink.astro';
import {getCollection} from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Art from '../components/Art.astro';
import Icon from '../components/Icon.astro';
import CTA from '../components/CTA.astro';
import {catalog,programOrder} from '../data/catalog';
import AudiencePaths from '../components/AudiencePaths.astro';
import CompletionRecognition from '../components/CompletionRecognition.astro';
const publicPrograms=(await getCollection('programs',({data})=>data.status!=='draft')).sort((a,b)=>programOrder.indexOf(a.data.href)-programOrder.indexOf(b.data.href));
---
<Layout title="Learn. Build. Make Ideas Work." description="Practical technology learning in AI, software engineering, machine learning, space systems and leadership — a Samkhya Technologies initiative.">
 <section class="container academy-home-hero"><div class="academy-photo"><Art name="academy-workshop" alt="Illustrative workshop scene showing a group collaborating around a laptop" priority /></div><div class="academy-hero-copy"><p class="eyebrow">SOFTWARE · AI · SPACE · LEADERSHIP</p><h1>Learn. Build.<br /><span>Make ideas work.</span></h1><p class="lede">Turn what you learn into work you can explain. Explore guided programs in software, machine learning, AI and space technology, develop your AI leadership skills, or take an early business idea forward with startup advisory.</p><div class="actions"><SiteLink class="button" href="/programs/">Explore programs <Icon name="arrowRight" /></SiteLink><SiteLink class="button outline" href="/about/">Discover the academy <Icon name="compass" /></SiteLink></div><div class="academy-values"><span><Icon name="code" />Practice-first learning</span><span><Icon name="users" />Guided projects</span><span><Icon name="target" />Work you can demonstrate</span></div></div></section>

<AudiencePaths/>
<section id="programs" class="container section program-section"><div class="section-heading"><div><p class="eyebrow">LEARNING, ENGINEERING & STARTUP ADVISORY.</p><h2>Find the right place<br />to take your next step.</h2></div><p>Start a technical learning journey, bring a college team together around a mission, or explore an early venture idea. Each direction has its own audience, approach and practical outputs.</p></div><div class="active-program-grid home-program-grid">{publicPrograms.map(({data:p})=><article class="active-program"><Art name={p.image} alt={`${p.title} conceptual illustration`} /><div class="active-program-copy"><span class="program-status"><Icon name={p.status==='active'?'book':'compass'}/>{p.href.includes('ai-engineering-internship')?'FLAGSHIP LEARNING PATH':'LEARNING PATH'}</span><h3>{p.title}</h3><p class="program-audience">{p.audience}</p><p>{p.summary}</p><div class="tags">{catalog[p.href].tags.map(tag=><span>{tag}</span>)}</div><div class="actions"><SiteLink class="button" href={p.href}>Explore the program <Icon name="arrowRight"/></SiteLink></div></div></article>)}</div></section>
<CompletionRecognition programTitle="AI Engineering Training Internship" example />
<section class="container section two-grid"><div><p class="eyebrow">BETTER TOGETHER</p><h2>Different disciplines.<br />Shared problems.</h2><p>An AI application needs a useful interface and trustworthy data. A satellite concept needs compatible mechanical, electrical and software assumptions. A venture needs a real user problem before it needs a larger feature list.</p><p>The academy connects these ways of thinking through practical work. Learn to explain your contribution, understand the interfaces and test the assumptions that matter.</p><SiteLink class="text-link" href="/about/">Meet the academy’s approach <Icon name="arrowRight"/></SiteLink></div><Art name="knowledge-bridge" alt="Conceptual bridge connecting knowledge and practical engineering" /></section>
<section class="dark-story"><div class="container two-grid"><Art name="space-tech" alt="Illustrative college team examining an educational satellite model"/><div><p class="eyebrow light">FOR COLLEGES & FACULTY COORDINATORS</p><h2>Give a student team<br />a mission to work towards.</h2><p>Bring together mechanical, electronics, computer science and AI learners. Explore a space-system concept through budgets, telemetry, simulation and a guided review.</p><p>Share your group’s experience and facilities so the teaching scope can be discussed. Trainer availability, hardware extensions and delivery arrangements are confirmed through enquiry.</p><SiteLink class="button white" href="/programs/space-technology/">Explore space technology <Icon name="arrowRight"/></SiteLink></div></div></section>
<section class="container section two-grid"><div><p class="eyebrow">FOR IDEAS THAT DESERVE A CLOSER LOOK</p><h2>Before the big build,<br />find the useful experiment.</h2><p>Venture Launchpad connects startup advisory with venture-building support: clarify the idea, validate demand, plan an MVP and agree how to move into execution.</p><p>Start by clarifying the problem and evidence for a non-confidential idea brief. Any follow-up or support is agreed separately; investment and selection are not promised.</p><div class="actions"><SiteLink class="button" href="/venture-studio/">Explore Venture Launchpad <Icon name="arrowRight"/></SiteLink><SiteLink class="text-link" href="/venture-studio/submit/">Prepare an idea brief <Icon name="file"/></SiteLink></div></div><Art name="venture-studio" alt="Conceptual venture development from an idea to a prototype"/></section>
<section class="container section section-tight"><div class="section-heading"><div><p class="eyebrow">HOW TO GET STARTED</p><h2>A clear next step for every starting point.</h2></div></div><div class="three-grid">{[['compass','Choose your direction','Read the audience, prerequisites and planned outputs. Each technical track has its own curriculum, projects and career preparation.'],['message','Start a conversation','Call, email or message the academy on WhatsApp. Share your starting point and ask about the program, fees and learning arrangements.'],['target','Agree a realistic scope','Discuss goals, readiness, timing and available support before committing. An enquiry is not an enrolment or a guarantee of participation.']].map(([icon,title,copy])=><article class="feature"><span class="feature-icon"><Icon name={icon}/></span><h3>{title}</h3><p>{copy}</p></article>)}</div></section><CTA/></Layout>
<style>.home-program-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.home-program-grid .active-program{display:flex;flex-direction:column;align-items:stretch;padding:0;gap:0;overflow:hidden}.home-program-grid .active-program>.art{order:0;padding:0}.home-program-grid .active-program>.art img{width:100%;height:190px;min-height:0;max-height:none;aspect-ratio:auto;object-fit:cover;border-radius:0}.home-program-grid .active-program-copy{padding:24px;display:flex;flex-direction:column;flex:1}.home-program-grid .active-program h3{font-size:1.45rem;margin:12px 0}.home-program-grid .active-program p{font-size:.81rem;line-height:1.75}.home-program-grid .active-program .program-audience{margin-bottom:12px}.home-program-grid .active-program .actions{margin-top:auto;padding-top:8px;gap:12px;align-items:flex-start}.home-program-grid .active-program .tags{margin:18px 0}.home-program-grid .active-program .text-link{font-size:.74rem}.academy-evidence-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px}.academy-evidence-grid .eyebrow{margin-top:22px;font-size:.61rem}.academy-evidence-grid .feature{background:#fff}.evidence-output{border-top:1px solid #e2e6f1;margin:22px 0;padding-top:16px}.evidence-output strong{font-size:.76rem}.evidence-output p{margin-top:8px}.academy-evidence-grid+.caption{margin-top:24px}@media(max-width:600px){.home-program-grid,.academy-evidence-grid{grid-template-columns:1fr}.home-program-grid .active-program>.art img{height:175px}.home-program-grid .active-program-copy{padding:22px}}</style>
