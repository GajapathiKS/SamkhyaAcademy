---
import Layout from '../../layouts/VentureLayout.astro';
import SecureForm from '../../components/SecureForm.astro';
import {site} from '../../../site.config.mjs';
const connected=site.ventureIntakeEnabled&&Boolean(site.ideaFormUrl);
---
<Layout section="submit" title="Share your venture idea" description="Share a non-confidential idea brief with Venture Launchpad. Describe the problem, audience, evidence and startup advisory support you need.">
<header class="container brief-heading"><p class="eyebrow">VENTURE LAUNCHPAD</p><h1>Let’s start with the problem you want to solve.</h1><p>Share an initial, non-confidential brief. Tell us what you have learned and where support would help.</p></header>
<section class="container brief-layout"><div>{connected?<SecureForm url={site.ideaFormUrl} title="SamkhyaAcademy venture idea brief"/>:<div class="card"><h2>Prepare your idea brief</h2><p>Online venture submissions are being prepared. You can <a href="/contact/">contact the academy</a> to discuss the next step.</p></div>}</div><aside><h2>A useful first conversation</h2><ul><li>The people facing the problem</li><li>What happens today and why it matters</li><li>Your idea and evidence so far</li><li>The next experiment or support you need</li></ul><h3>Your idea remains yours.</h3><p>Share only a high-level brief. Do not include trade secrets, passwords or confidential implementation details.</p><p>Submitting does not create an engagement or promise selection, investment or funding. Scope, fees and any confidentiality agreement are discussed separately.</p><p><a href="/venture-studio/journey/">Explore the advisory journey</a></p><p><a href="/privacy/">Privacy notice</a> · <a href="/terms/">Terms</a></p></aside></section>
</Layout>
<style>.brief-heading{padding-block:24px 18px}.brief-heading h1{font-size:clamp(1.6rem,3vw,2.25rem);max-width:850px;line-height:1.2;margin:8px 0 12px}.brief-heading p{max-width:760px}.brief-layout{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(0,1fr);gap:32px;padding-bottom:64px}.brief-layout>div{min-width:0}.brief-layout aside{padding:24px;background:#f5f8fc;border-radius:14px;align-self:start}.brief-layout aside h2{font-size:1.35rem}.brief-layout aside h3{margin-top:24px}.brief-layout li{margin-block:10px}.brief-layout aside p{margin-top:16px;font-size:.88rem}@media(max-width:850px){.brief-layout{grid-template-columns:1fr;padding-bottom:40px}}</style>
